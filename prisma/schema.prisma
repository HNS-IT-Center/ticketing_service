// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  Administrator
  Technician
  Sales
  Customer
  RMA          // Handles warranty claims sent to vendors
  // Signed in through HNS SSO but not yet given a role here. SSO decides who
  // may enter the app at all; what they may do inside it is this app's call,
  // and every other role opens customer data, so none is a safe default.
  Pending
}

enum Shift {
  morning
  noon
}

enum TicketType {
  service
  warranty_claim
  pc_build
  cleaning
  upgrade
}

// CS intake label — separate from TicketType (internal technical classification)
enum ServiceCategory {
  service
  build_pc
  upgrade
  diagnostic
  on_site
  others
}

enum PickupMethod {
  self_pickup
  courier
}

enum TicketStatus {
  waiting
  on_progress
  done
  ready_for_pickup   // After done: item ready at counter (self-pickup)
  waiting_pickup     // Customer has been notified, not yet picked up
  handed_to_courier  // After done: item handed to courier (courier pickup)
  delivered          // Courier delivered to customer
  completed          // Final state for both pickup paths
  cancelled
  rejected
  rma_process        // Warranty claim handed over to RMA — see RmaCase for the detailed state
}

enum DeviceType {
  PC_Office
  PC_Gaming
  Laptop_Office
  Laptop_Gaming
  Printer
  Other_Device
}

enum CustomerType {
  User
  Internet_Cafe
  Company
  Dealer
}

enum TimeLogEvent {
  START
  PAUSE
  RESUME
  DONE
}

enum FileType {
  image
  video
  pdf
}

enum NotificationType {
  message
  status_update
  assigned    // Technician was assigned a ticket
  completed   // Technician completed a ticket (includes points earned)
  rma_update  // RMA case moved to a new state
}

enum CleaningPackage {
  Deep_Clean
  Repaste
  Basic_Cleaning
  Full_Repaste
  Full_Repaste_CPU_GPU
}

// ── RMA (warranty claim sent to vendor) ──
// Kept as its own enum instead of flooding TicketStatus: the ticket only ever
// sees `rma_process`, while the detailed vendor workflow lives on RmaCase.

enum UnitOwnership {
  customer     // unit belongs to the customer
  store_stock  // unit came from store stock
}

enum RmaStatus {
  pending_verification
  on_hold
  verified
  submitted_to_vendor
  in_vendor_process
  vendor_decided
  unit_received
  closed
  // Examined by the RMA desk and found outside warranty cover, before the unit
  // ever went to a vendor. Distinct from RmaDecision.rejected, which is the
  // vendor turning a claim down after receiving it, and from `cancelled`, which
  // is a claim abandoned rather than judged.
  ineligible
  cancelled
}

/**
 * Why an RMA case is on hold.
 *
 * The three `missing_*` values are things only the technician who handed the
 * unit over can supply, so choosing one asks them for it by name. `other` is
 * everything else: the desk types the reason and an administrator is told,
 * because nothing automatic can resolve it.
 */
enum RmaHoldReason {
  missing_damage_video
  missing_damage_photo
  missing_purchase_invoice
  other
}

enum RmaDecision {
  repaired
  replaced
  refund
  rejected
}

// ─────────────────────────────────────────────
// STORE LOCATIONS
// ─────────────────────────────────────────────

model StoreLocation {
  id         String  @id @default(cuid())
  name       String  @unique       // e.g. "Nagoya Gateway"
  code       String  @unique       // e.g. "NGW" — used in ticket_code prefix
  address    String? @db.Text
  is_active  Boolean @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tickets           Ticket[]
  technician_stores TechnicianStoreAssignment[]
}

model TechnicianStoreAssignment {
  id            String        @id @default(cuid())
  technician_id String
  technician    User          @relation(fields: [technician_id], references: [id], onDelete: Cascade)
  store_id      String
  store         StoreLocation @relation(fields: [store_id], references: [id], onDelete: Cascade)
  assigned_at   DateTime      @default(now())

  @@unique([technician_id, store_id])
  @@index([technician_id])
}

// ─────────────────────────────────────────────
// USERS
// ─────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone_number String
  address      String @db.Text
  role         Role     @default(Customer)
  password     String?

  // Technician-specific
  shift     Shift?
  work_days Json?  // e.g. ["Mon","Tue","Wed"]

  // Team leader flag — excluded from leaderboard display but can still work on tickets
  is_team_leader Boolean @default(false)

  // Head technician: a senior technician who, with store coordinators, may see
  // purchase costs and margins. What each group may do lives in AccessRule.
  is_head_technician Boolean @default(false)

  // Achievement title inventory — stores which title_key is currently equipped
  active_title String?

  // Soft-delete flag — false = deactivated (cannot log in, hidden from UI)
  is_active    Boolean  @default(true)

  // HNS SSO subject (`sub` claim): the stable identity this row is tied to.
  // Matched on every SSO login; email is used only to make the first link.
  sso_sub      String?  @unique

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  tickets_created    Ticket[]              @relation("TicketUser")
  tickets_technician Ticket[]              @relation("TicketTechnician")
  tickets_sales      Ticket[]              @relation("TicketSales")
  messages_sent      TicketMessage[]
  notifications      Notification[]
  status_logs        TicketStatusLog[]
  workload           TechnicianWorkload?
  performance        TechnicianPerformance?
  leaderboards       Leaderboard[]
  store_assignments  TechnicianStoreAssignment[]
  leaves             TechnicianLeave[]
  overridden_shifts  ShiftOverride[]       @relation("OriginalShift")
  overriding_shifts  ShiftOverride[]       @relation("OverrideShift")
  assignment_requests TicketAssignmentRequest[]
  titles             UserTitle[]
  rma_handovers      RmaCase[]             @relation("RmaHandedOverBy")
  rma_cases_handled  RmaCase[]             @relation("RmaHandler")
  tickets_deleted    DeletedTicketLog[]    @relation("TicketDeletedBy")
  parts_recorded     TicketReplacedPart[]  @relation("PartRecordedBy")
  charges_created    TicketCharge[]        @relation("ChargeCreatedBy")
  charges_updated    TicketCharge[]        @relation("ChargeUpdatedBy")
  sso_sessions       SsoSession[]
  rma_events         RmaEvent[]

  @@index([email])
}

// ─────────────────────────────────────────────
// TICKETS
// ─────────────────────────────────────────────

model Ticket {
  id          String @id @default(cuid())
  ticket_code String @unique

  user_id String?
  user    User?   @relation("TicketUser", fields: [user_id], references: [id])

  ticket_type      TicketType
  service_category ServiceCategory?  // CS intake label (what customer came in for)
  status           TicketStatus @default(waiting)
  device_type      DeviceType

  technician_id String?
  technician    User?   @relation("TicketTechnician", fields: [technician_id], references: [id])

  sales_id String?
  sales    User?   @relation("TicketSales", fields: [sales_id], references: [id])

  // Store location — original intake store (NEVER changes after creation)
  store_location_id String?
  store_location    StoreLocation? @relation(fields: [store_location_id], references: [id])

  notes            String? @db.LongText // Rich text (HTML) — visible to all
  technician_notes String? @db.Text // Notes from CS to technician — plain text

  is_for_self      Boolean @default(true)  // false = ticket created on behalf of another person
  customer_name    String?                 // Name of the actual recipient (if is_for_self = false)
  customer_phone   String?
  customer_email   String?
  customer_address String? @db.Text

  customer_type    CustomerType @default(User)

  // CS intake fields
  accessories      String? @db.Text // accessories included with device
  device_condition String? @db.Text // customer-described physical condition
  device_name      String?        // Optional device name
  device_sn        String?        // Optional device serial number
  warranty_status  String?        // 'active' or 'inactive'
  is_overnight     Boolean  @default(false)  // true = multi-day service
  is_overnight_check Boolean @default(false)
  checking_fee     Decimal? @db.Decimal(12,2)
  pickup_method    PickupMethod?
  terms_accepted   Boolean  @default(false)

  payment_proof_url   String? @db.Text
  delivery_proof_url  String? @db.Text
  progress_proof_url  String? @db.Text
  revision_proof_url  String? @db.Text

  // Extra services added during the ticket (e.g. "Repaste", "Upgrade") — each adds +3 bonus points
  extra_services      Json      @default("[]")

  // Public access
  public_chat_enabled Boolean @default(false)
  public_share_token  String? @unique    // secure token for /ticket/[token] public page

  // Performance tracking timestamps
  work_started_at   DateTime?  // set when technician moves to on_progress
  work_completed_at DateTime?  // set when technician moves to done

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  attachments      TicketAttachment[]
  messages         TicketMessage[]
  status_logs      TicketStatusLog[]
  time_logs        TicketTimeLog[]
  notifications    Notification[]
  service_detail   TicketServiceDetail?
  replaced_parts   TicketReplacedPart[]
  charges          TicketCharge[]
  warranty_detail  TicketWarrantyDetail?
  cleaning_detail  TicketCleaningDetail?
  upgrade_details  TicketUpgradeDetail[]
  pc_build_detail  TicketPcBuildDetail?
  pc_components    TicketPcBuildComponent[]
  assignment_requests TicketAssignmentRequest[]
  rma_case         RmaCase?

  @@index([user_id])
  @@index([technician_id])
  @@index([store_location_id])
  @@index([public_share_token])
}

model TicketAssignmentRequest {
  id            String   @id @default(cuid())
  ticket_id     String
  ticket        Ticket   @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  technician_id String
  technician    User     @relation(fields: [technician_id], references: [id], onDelete: Cascade)
  status        String   @default("pending") // pending, approved, rejected
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@unique([ticket_id, technician_id])
}

// ─────────────────────────────────────────────
// TICKET DETAIL TABLES
// ─────────────────────────────────────────────

model TicketServiceDetail {
  id        String @id @default(cuid())
  ticket_id String @unique
  ticket    Ticket @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
}

model TicketWarrantyDetail {
  id            String   @id @default(cuid())
  ticket_id     String   @unique
  ticket        Ticket   @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  // Required for a customer's unit — it is what the warranty is measured from.
  // Optional for store stock: the shop bought it from a supplier, and the
  // customer-facing purchase date does not exist.
  purchase_date DateTime?

  // Who owns the unit, known at the counter the moment it arrives. Until
  // 2026-10-08 this was first asked at handover to RMA, so a store-stock claim
  // had to be opened with an invented customer name and phone number. Nullable
  // because claims opened before then never recorded it; when set, the
  // handover takes it from here rather than asking again.
  unit_ownership UnitOwnership?
  stock_origin   String?   @db.Text // required when unit_ownership = store_stock

  // Set by the server when a technician closes a claim as ineligible. The
  // ticket still goes to `done` so the normal handover chain can return the
  // unit to the customer — see docs/rma-test-checklist.md.
  claim_eligible       Boolean @default(true)
  ineligibility_reason String? @db.Text
}

model TicketCleaningDetail {
  id              String          @id @default(cuid())
  ticket_id       String          @unique
  ticket          Ticket          @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  service_package CleaningPackage
}

model Upgrade {
  id     String @id @default(cuid())
  name   String @unique
  points Int    @default(2)

  upgrade_details TicketUpgradeDetail[]
}

model TicketUpgradeDetail {
  id         String  @id @default(cuid())
  ticket_id  String
  ticket     Ticket  @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  upgrade_id String
  upgrade    Upgrade @relation(fields: [upgrade_id], references: [id])
}

model TicketPcBuildDetail {
  id                 String  @id @default(cuid())
  ticket_id          String  @unique
  ticket             Ticket  @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  first_build_url    String? @db.Text // Uploaded by technician upon marking done
  revision_build_url String? @db.Text // Uploaded by assigned Sales
}

model TicketPcBuildComponent {
  id             String @id @default(cuid())
  ticket_id      String
  ticket         Ticket @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  component_name String
}

// ─────────────────────────────────────────────
// ATTACHMENTS & MESSAGES
// ─────────────────────────────────────────────

// What an attachment is, where the app needs to tell: the invoice the RMA desk
// verifies, and the photos of a claimed unit taken when it was received. Null
// for everything else (work proof, handover photos, PC build layouts), which
// is told apart by its file name as before.
enum AttachmentKind {
  invoice
  unit_photo
}

model TicketAttachment {
  id         String   @id @default(cuid())
  ticket_id  String
  ticket     Ticket   @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  file_url   String @db.Text
  file_type  FileType
  kind       AttachmentKind?
  created_at DateTime @default(now())
}

model TicketMessage {
  id        String @id @default(cuid())
  ticket_id String
  ticket    Ticket @relation(fields: [ticket_id], references: [id], onDelete: Cascade)

  sender_id   String?       // null = anonymous public message
  sender      User?   @relation(fields: [sender_id], references: [id])
  sender_name String?       // for anonymous senders

  message  String @db.Text
  is_read  Boolean @default(false)

  created_at DateTime @default(now())

  @@index([ticket_id])
}

// ─────────────────────────────────────────────
// STATUS LOGS
// ─────────────────────────────────────────────

model TicketStatusLog {
  id         String       @id @default(cuid())
  ticket_id  String
  ticket     Ticket       @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  old_status TicketStatus?
  new_status TicketStatus
  reason     String? @db.Text
  changed_by String
  changer    User         @relation(fields: [changed_by], references: [id])
  created_at DateTime     @default(now())
}

// ─────────────────────────────────────────────
// WORKLOAD & PERFORMANCE
// ─────────────────────────────────────────────

model TechnicianWorkload {
  id             String   @id @default(cuid())
  technician_id  String   @unique
  technician     User     @relation(fields: [technician_id], references: [id])
  current_points Int      @default(0)
  max_points     Int      @default(7)
  updated_at     DateTime @updatedAt
}

model TechnicianPerformance {
  id            String @id @default(cuid())
  technician_id String @unique
  technician    User   @relation(fields: [technician_id], references: [id])

  tickets_handled        Int @default(0)
  success_count          Int @default(0)
  failed_count           Int @default(0)
  total_points_completed Int @default(0)

  updated_at DateTime @updatedAt
}

model Leaderboard {
  id            String @id @default(cuid())
  technician_id String
  technician    User   @relation(fields: [technician_id], references: [id])

  month Int
  year  Int

  total_points    Int
  tickets_handled Int

  created_at DateTime @default(now())
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────

model Notification {
  id        String @id @default(cuid())
  user_id   String
  user      User   @relation(fields: [user_id], references: [id])
  ticket_id String
  ticket    Ticket @relation(fields: [ticket_id], references: [id], onDelete: Cascade)

  type         NotificationType
  reference_id String? // e.g. message_id or status_log_id
  message      String? @db.Text // Optional human-readable detail (e.g. points earned message)

  is_read Boolean @default(false)

  created_at DateTime @default(now())

  @@index([user_id])
}

// ─────────────────────────────────────────────
// TIME LOGGING & SCHEDULING (PHASE 3)
// ─────────────────────────────────────────────

model TicketTimeLog {
  id         String       @id @default(cuid())
  ticket_id  String
  ticket     Ticket       @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  event      TimeLogEvent
  reason     String? @db.Text
  created_at DateTime     @default(now())

  @@index([ticket_id])
}

model TechnicianLeave {
  id            String   @id @default(cuid())
  technician_id String
  technician    User     @relation(fields: [technician_id], references: [id], onDelete: Cascade)
  date          DateTime @db.Date
  reason        String? @db.Text
  is_off_day    Boolean  @default(false)
  created_at    DateTime @default(now())

  @@unique([technician_id, date])
}

model ShiftOverride {
  id               String   @id @default(cuid())
  original_tech_id String
  override_tech_id String
  original_tech    User     @relation("OriginalShift", fields: [original_tech_id], references: [id], onDelete: Cascade)
  override_tech    User     @relation("OverrideShift", fields: [override_tech_id], references: [id], onDelete: Cascade)
  date             DateTime @db.Date
  shift            Shift
  created_at       DateTime @default(now())

  @@unique([original_tech_id, date])
}

// ─────────────────────────────────────────────
// ACHIEVEMENT TITLES (Game Inventory)
// ─────────────────────────────────────────────

model UserTitle {
  id          String   @id @default(cuid())
  user_id     String
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  title_key   String   // e.g. "technician_2026_04" or "coordinator_2026_05"
  title_label String   // e.g. "Technician of April 2026"
  title_type  String   // "technician" | "coordinator"
  // No DB-level default: MariaDB stores defaults in `character_set_system`
  // (utf8mb3), so a four-byte emoji becomes '?'. Both callers in
  // lib/performance.ts pass this explicitly. See the migration for the proof.
  emoji       String
  awarded_at  DateTime @default(now())

  @@unique([user_id, title_key])
  @@index([user_id])
}

// ─────────────────────────────────────────────
// RMA — WARRANTY CLAIM SENT TO VENDOR
// ─────────────────────────────────────────────

// One case per warranty_claim ticket, created when the technician hands the
// unit over to the RMA desk. The parent ticket sits at `rma_process` for the
// whole vendor round-trip and returns to `done` when the case closes, so the
// existing handover chain (ready_for_pickup / handed_to_courier -> completed)
// keeps working untouched.
model RmaCase {
  id        String    @id @default(cuid())
  rma_code  String    @unique          // RMA-{STORECODE}-{YYMM}-{0001}
  ticket_id String    @unique
  ticket    Ticket    @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  status    RmaStatus @default(pending_verification)

  // ── Service form — filled by the technician at handover ──
  unit_ownership       UnitOwnership
  stock_origin         String?   @db.Text // free text, required when unit_ownership = store_stock
  // Number of the goods-transfer document that moved the unit out of the store
  // warehouse and into the claim warehouse. Required by the application before
  // a store_stock case may be verified; nullable here because a customer's own
  // unit is never transferred and has nothing to record.
  stock_transfer_number String?
  purchase_invoice_url String? @db.Text // required when unit_ownership = customer
  sn_verified          Boolean   @default(false)
  physical_condition   String @db.Text
  fault_description    String @db.Text
  // TEXT, like the rest of the form. Was VARCHAR(191): the column M3 missed, and
  // a technician's test notes ran past it on 2026-10-16 — the handover failed.
  test_result          String @db.Text
  handed_over_by_id    String
  handed_over_by       User      @relation("RmaHandedOverBy", fields: [handed_over_by_id], references: [id])
  handed_over_at       DateTime  @default(now())

  // ── Technician's recommendation at handover ──
  // Advisory only. The RMA desk decides eligibility; this records what the
  // person who physically examined the unit thought. It must never gate a
  // transition, preselect the desk's choice, or reach the public page.
  // Nullable in the database because seven cases predate this field; required
  // at handover in the application, the same way device_sn is.
  recommended_eligible Boolean?
  recommendation_note  String? @db.Text

  // ── Handling ──
  handler_id  String?
  handler     User?   @relation("RmaHandler", fields: [handler_id], references: [id])
  // Why the case is held, as a category the desk picks rather than prose.
  // `hold_reason` carries the words; this carries the kind, because the kind is
  // what decides whether the system goes back to the technician and asks for
  // something — and what a report can later count.
  hold_reason_code RmaHoldReason?
  hold_reason String? @db.Text

  // ── Vendor ──
  vendor_name       String?
  // The claim number raised with the supplier. Only a store-stock unit has one:
  // the shop claims against its own supplier. Labelled "Nomor Klaim Pemasok".
  vendor_rma_number String?   // internal only — never shown on the public page
  // A customer's own unit is not claimed against a supplier, so it carries the
  // reference number the outside party gave instead — optional, because it
  // often has not been issued yet when the unit is sent.
  customer_ticket_number String?
  shipping_tracking String?
  submitted_at      DateTime?

  // ── Outcome ──
  decision         RmaDecision?
  decision_notes   String? @db.Text
  replacement_sn   String?     // required when decision = replaced
  decided_at       DateTime?
  unit_received_at DateTime?
  closed_at        DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  events RmaEvent[]

  @@index([status])
  @@index([handler_id])
}

// Append-only audit trail of every RMA state change.
model RmaEvent {
  id          String     @id @default(cuid())
  rma_case_id String
  rma_case    RmaCase    @relation(fields: [rma_case_id], references: [id], onDelete: Cascade)
  from_status RmaStatus?
  to_status   RmaStatus
  note        String? @db.Text
  actor_id    String
  actor       User       @relation(fields: [actor_id], references: [id])
  created_at  DateTime   @default(now())

  @@index([rma_case_id])
}

/**
 * What an administrator destroyed, kept after the thing itself is gone.
 *
 * Deleting a Ticket cascades into thirteen tables — TicketStatusLog,
 * TicketMessage, TicketAttachment, TicketTimeLog, the per-type detail rows, and
 * RmaCase, which takes its RmaEvent trail with it. Nothing survives that could
 * answer "what happened to NGW-000123?" afterwards, which is why this row
 * deliberately holds NO foreign key to Ticket: it has to outlive it.
 *
 * `snapshot` carries the ticket as it stood plus counts of everything the
 * cascade removed and the URLs of its attachments, so an orphaned file in the
 * bucket can still be traced back to the ticket it belonged to.
 */
model DeletedTicketLog {
  id          String       @id @default(cuid())
  ticket_code String
  ticket_type TicketType
  status      TicketStatus

  customer_name   String? @db.Text
  store_code      String?
  technician_name String? @db.Text

  deleted_by_id   String
  deleted_by      User   @relation("TicketDeletedBy", fields: [deleted_by_id], references: [id])
  deleted_by_name String @db.Text
  reason          String @db.Text

  /** The ticket as it stood, the cascade's body count, and attachment URLs. */
  snapshot Json

  /** Credits taken back off TechnicianPerformance, so the reversal is auditable. */
  points_reversed  Int @default(0)
  success_reversed Int @default(0)
  failed_reversed  Int @default(0)

  created_at DateTime @default(now())

  @@index([ticket_code])
  @@index([created_at])
}

/**
 * Which component a service replaced.
 *
 * An enum and not free text, deliberately. `device_name` and `vendor_name` are
 * both free text and both splintered — "ASUS ROG", "Asus TUF" and "ROG JANGKAR"
 * are one manufacturer written three ways, which is why the dashboard's brand
 * chart had to be withdrawn: it measured how people type, not what was claimed.
 * A part picked from this list can be counted; a part typed as prose cannot.
 *
 * The specific item fitted still gets a free-text field beside it — that is the
 * part number, and nobody counts part numbers.
 */
enum ServicePart {
  lcd
  battery
  keyboard
  charger
  ram
  storage
  motherboard
  fan
  speaker
  casing
  other
}

/**
 * One component replaced during a service, recorded by the technician who
 * fitted it. A ticket may have several.
 */
model TicketReplacedPart {
  id        String      @id @default(cuid())
  ticket_id String
  ticket    Ticket      @relation(fields: [ticket_id], references: [id], onDelete: Cascade)

  part ServicePart

  /**
   * What was actually fitted, e.g. "Baterai ASUS C31N1915". Optional, because
   * a technician who swapped a generic fan has nothing useful to type, and
   * required-but-meaningless fields get filled with a full stop.
   */
  item_name String? @db.Text

  /** Free note: why it was replaced, what the old one did. */
  notes String? @db.Text

  /**
   * The item as it stands in the company catalogue (Accurate, read through
   * data.hnsitcenter.id), when the technician picked it from the search rather
   * than typing it. Copied at the time of recording — a snapshot, not a live
   * link — so a report still reads the same after the catalogue changes. This
   * app never writes back to Accurate: purchasing and stock live there; this is
   * the technicians' own record of what they fitted.
   */
  catalog_item_id  Int?
  sku              String?
  catalog_category String?
  quantity         Int     @default(1)

  recorded_by_id String
  recorded_by    User   @relation("PartRecordedBy", fields: [recorded_by_id], references: [id])

  /**
   * Photos of what was fitted — the box and the label, which is what the
   * technicians already photograph by habit. They belong to the part and not
   * to the ticket: a ticket-level attachment cannot say which of three
   * replaced components it is a picture of.
   */
  photos TicketReplacedPartPhoto[]

  /** The line that prices this part in the ticket's Rincian Biaya. */
  charge TicketCharge?

  created_at DateTime @default(now())

  @@index([ticket_id])
  @@index([sku])
  @@index([created_at])
}

/** One photo of a replaced component. Dies with the part it documents. */
model TicketReplacedPartPhoto {
  id      String             @id @default(cuid())
  part_id String
  part    TicketReplacedPart @relation(fields: [part_id], references: [id], onDelete: Cascade)

  file_url String @db.Text

  created_at DateTime @default(now())

  @@index([part_id])
}

// One row per local sign-in through HNS SSO.
//
// The app's own session is a signed cookie with nothing behind it, so on its own
// it cannot be ended from outside. SSO back-channel logout names an SSO session
// (`sid`), and this row is how that name reaches the cookies it issued: the
// cookie carries this row's id, and every request checks the row has not been
// revoked. Tokens stay here, on the server, never in the browser.
model SsoSession {
  id      String  @id @default(cuid())
  sid     String? // SSO session id from the id_token; changes on every SSO login
  sub     String
  user_id String
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  id_token          String    @db.Text
  access_token      String    @db.Text
  refresh_token     String?   @db.Text
  access_expires_at DateTime

  // Refresh tokens rotate and a reused one revokes the whole chain, so only one
  // request may refresh at a time. Taken with a conditional update.
  refresh_locked_until DateTime?

  revoked_at     DateTime?
  revoked_reason String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([sid])
  @@index([user_id])
}

// Who may see and change what, beyond the defaults in lib/access.ts.
// One row per (capability, audience) the owner has changed from its default;
// no row means the default applies. Capabilities and audiences are the string
// keys listed in lib/access.ts, so adding one needs no migration.
model AccessRule {
  id            String   @id @default(cuid())
  capability    String
  audience      String
  allowed       Boolean
  updated_by_id String?
  updated_at    DateTime @updatedAt

  @@unique([capability, audience])
}

enum VendorKind {
  part_supplier   // sells the parts fitted during a service
  repair_service  // repairs what the shop does not, e.g. board / IC work
  both
}

// Suppliers and outside repairers. Picked from a list rather than typed, so
// one vendor is one row — the free-text vendor_name on RmaCase splintered into
// several spellings of the same company.
model Vendor {
  id         String     @id @default(cuid())
  name       String     @unique // the collation is case-insensitive: "ACME" == "Acme"
  kind       VendorKind @default(part_supplier)
  contact    String?    @db.Text
  notes      String?    @db.Text
  is_active  Boolean    @default(true)
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt

  charges TicketCharge[]
}

/// What a line of a service bill is for.
enum ChargeKind {
  part             // a component fitted; created together with the TicketReplacedPart it prices
  external_service // work sent out to a vendor, e.g. IC or board repair
  service_fee      // the shop's own labour
  other
}

/// How external work came back from the vendor.
enum ExternalResult {
  repaired
  not_repaired
}

// One line of a service ticket's bill — "Rincian Biaya".
//
// The shop holds no stock of most parts: an LCD, a battery or a keyboard is
// bought from a supplier for the job, and board work goes to another vendor.
// So every line can carry two prices: what the shop paid (`unit_cost`, "harga
// modal") and what the customer is charged (`unit_price`, "harga jual"). Who
// may see or set each is the owner's call, in Admin -> Pengaturan Akses
// (`lib/access.ts`); the page never sends a cost to a browser that may not see
// it, and the action never writes one the caller may not set.
//
// Rupiah, whole numbers. Null means "not filled in yet", which is different
// from 0 — a warranty swap can be charged at 0 on purpose, and the bill says
// so rather than looking unfinished.
//
// A part line is created with the TicketReplacedPart it prices and dies with
// it, so a part cannot be removed while its price lingers on the bill.
model TicketCharge {
  id        String @id @default(cuid())
  ticket_id String
  ticket    Ticket @relation(fields: [ticket_id], references: [id], onDelete: Cascade)

  kind        ChargeKind
  description String     @db.Text
  quantity    Int        @default(1)

  replaced_part_id String?             @unique
  replaced_part    TicketReplacedPart? @relation(fields: [replaced_part_id], references: [id], onDelete: Cascade)

  // Picked from the vendor list, never typed: free-text vendor names are what
  // split one supplier into three in the RMA dashboard.
  vendor_id String?
  vendor    Vendor? @relation(fields: [vendor_id], references: [id], onDelete: SetNull)

  unit_cost  Int?
  unit_price Int?

  // External work only: the trip to the vendor and back. `sent_at` set and
  // `returned_at` empty means the work is at the vendor now.
  sent_at         DateTime?
  returned_at     DateTime?
  external_result ExternalResult?
  external_note   String?         @db.Text

  created_by_id String
  created_by    User    @relation("ChargeCreatedBy", fields: [created_by_id], references: [id])
  updated_by_id String?
  updated_by    User?   @relation("ChargeUpdatedBy", fields: [updated_by_id], references: [id], onDelete: SetNull)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([ticket_id])
  @@index([vendor_id])
  @@index([created_at])
}
