# Database connection string (Supabase Session Pooler - port 5432 or 6543)
# IMPORTANT: Must append ?sslmode=no-verify if using Supabase Pooler
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=no-verify"

# TLS mode. Leave UNSET for Supabase (TLS on, certificate verification off — the
# session pooler serves a self-signed chain). Set to false ONLY for a local
# Postgres container, which speaks plain TCP:
#   DATABASE_URL="postgresql://postgres:devpass@127.0.0.1:5433/ticketing"
#   DATABASE_SSL=false
# DATABASE_SSL=false

# Supabase Project settings
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Authentication Session Secret (Generate a random 32+ char string)
SESSION_SECRET="generate-a-random-32+-char-string-here"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Email (Resend) ─────────────────────────────────────────────────────────────
# Sign up at https://resend.com — free plan allows 3,000 emails/month
# Your domain must be verified to send from custom addresses.
# During development, you can send to verified email addresses without a custom domain.
RESEND_API_KEY="re_your_resend_api_key_here"
NEXT_PUBLIC_FROM_EMAIL="noreply@yourdomain.com"

# ── File storage ──────────────────────────────────────────────────────────────
# Production uses Cloudflare R2. Two ways to develop without R2 credentials:
#
#   1. MinIO (recommended) — runs the same S3 code path as production, so bugs
#      in it surface locally instead of after deploy. See
#      docs/minio-local-storage.md, then `npm run setup:minio`.
#   2. STORAGE_DRIVER=local — writes into public/uploads/, which Next.js serves
#      statically. Simpler, but it bypasses the S3 code entirely, so nothing in
#      that path gets exercised. Refuses to run in production.
#
# STORAGE_DRIVER=local

# Leave R2_ENDPOINT empty for Cloudflare R2. Set it to point at any
# S3-compatible server, e.g. http://127.0.0.1:9000 for local MinIO.
# A non-https endpoint is refused when NODE_ENV=production.
R2_ENDPOINT=""

R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# With MinIO this must include the bucket name, because MinIO is addressed
# path-style: http://127.0.0.1:9000/<bucket>
NEXT_PUBLIC_R2_PUBLIC_URL=""
