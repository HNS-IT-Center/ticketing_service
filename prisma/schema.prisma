// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  Administrator
  Technician
  Sales
  Customer
  RMA          // Handles warranty claims sent to vendors
}

enum Shift {
  morning
  noon
}

enum TicketType {
  service
  warranty_claim
  pc_build
  cleaning
  upgrade
}

// CS intake label — separate from TicketType (internal technical classification)
enum ServiceCategory {
  service
  build_pc
  upgrade
  diagnostic
  on_site
  others
}

enum PickupMethod {
  self_pickup
  courier
}

enum TicketStatus {
  waiting
  on_progress
  done
  ready_for_pickup   // After done: item ready at counter (self-pickup)
  waiting_pickup     // Customer has been notified, not yet picked up
  handed_to_courier  // After done: item handed to courier (courier pickup)
  delivered          // Courier delivered to customer
  completed          // Final state for both pickup paths
  cancelled
  rejected
  rma_process        // Warranty claim handed over to RMA — see RmaCase for the detailed state
}

enum DeviceType {
  PC_Office
  PC_Gaming
  Laptop_Office
  Laptop_Gaming
  Printer
  Other_Device
}

enum CustomerType {
  User
  Internet_Cafe
  Company
  Dealer
}

enum TimeLogEvent {
  START
  PAUSE
  RESUME
  DONE
}

enum FileType {
  image
  video
  pdf
}

enum NotificationType {
  message
  status_update
  assigned    // Technician was assigned a ticket
  completed   // Technician completed a ticket (includes points earned)
  rma_update  // RMA case moved to a new state
}

enum CleaningPackage {
  Deep_Clean
  Repaste
  Basic_Cleaning
  Full_Repaste
  Full_Repaste_CPU_GPU
}

// ── RMA (warranty claim sent to vendor) ──
// Kept as its own enum instead of flooding TicketStatus: the ticket only ever
// sees `rma_process`, while the detailed vendor workflow lives on RmaCase.

enum UnitOwnership {
  customer     // unit belongs to the customer
  store_stock  // unit came from store stock
}

enum RmaStatus {
  pending_verification
  on_hold
  verified
  submitted_to_vendor
  in_vendor_process
  vendor_decided
  unit_received
  closed
  // Examined by the RMA desk and found outside warranty cover, before the unit
  // ever went to a vendor. Distinct from RmaDecision.rejected, which is the
  // vendor turning a claim down after receiving it, and from `cancelled`, which
  // is a claim abandoned rather than judged.
  ineligible
  cancelled
}

enum RmaDecision {
  repaired
  replaced
  refund
  rejected
}

// ─────────────────────────────────────────────
// STORE LOCATIONS
// ─────────────────────────────────────────────

model StoreLocation {
  id         String  @id @default(cuid())
  name       String  @unique       // e.g. "Nagoya Gateway"
  code       String  @unique       // e.g. "NGW" — used in ticket_code prefix
  address    String? @db.Text
  is_active  Boolean @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tickets           Ticket[]
  technician_stores TechnicianStoreAssignment[]
}

model TechnicianStoreAssignment {
  id            String        @id @default(cuid())
  technician_id String
  technician    User          @relation(fields: [technician_id], references: [id], onDelete: Cascade)
  store_id      String
  store         StoreLocation @relation(fields: [store_id], references: [id], onDelete: Cascade)
  assigned_at   DateTime      @default(now())

  @@unique([technician_id, store_id])
  @@index([technician_id])
}

// ─────────────────────────────────────────────
// USERS
// ─────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone_number String
  address      String @db.Text
  role         Role     @default(Customer)
  password     String?

  // Technician-specific
  shift     Shift?
  work_days Json?  // e.g. ["Mon","Tue","Wed"]

  // Team leader flag — excluded from leaderboard display but can still work on tickets
  is_team_leader Boolean @default(false)

  // Achievement title inventory — stores which title_key is currently equipped
  active_title String?

  // Soft-delete flag — false = deactivated (cannot log in, hidden from UI)
  is_active    Boolean  @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  tickets_created    Ticket[]              @relation("TicketUser")
  tickets_technician Ticket[]              @relation("TicketTechnician")
  tickets_sales      Ticket[]              @relation("TicketSales")
  messages_sent      TicketMessage[]
  notifications      Notification[]
  status_logs        TicketStatusLog[]
  workload           TechnicianWorkload?
  performance        TechnicianPerformance?
  leaderboards       Leaderboard[]
  store_assignments  TechnicianStoreAssignment[]
  leaves             TechnicianLeave[]
  overridden_shifts  ShiftOverride[]       @relation("OriginalShift")
  overriding_shifts  ShiftOverride[]       @relation("OverrideShift")
  assignment_requests TicketAssignmentRequest[]
  titles             UserTitle[]
  rma_handovers      RmaCase[]             @relation("RmaHandedOverBy")
  rma_cases_handled  RmaCase[]             @relation("RmaHandler")
  rma_events         RmaEvent[]

  @@index([email])
}

// ─────────────────────────────────────────────
// TICKETS
// ─────────────────────────────────────────────

model Ticket {
  id          String @id @default(cuid())
  ticket_code String @unique

  user_id String?
  user    User?   @relation("TicketUser", fields: [user_id], references: [id])

  ticket_type      TicketType
  service_category ServiceCategory?  // CS intake label (what customer came in for)
  status           TicketStatus @default(waiting)
  device_type      DeviceType

  technician_id String?
  technician    User?   @relation("TicketTechnician", fields: [technician_id], references: [id])

  sales_id String?
  sales    User?   @relation("TicketSales", fields: [sales_id], references: [id])

  // Store location — original intake store (NEVER changes after creation)
  store_location_id String?
  store_location    StoreLocation? @relation(fields: [store_location_id], references: [id])

  notes            String? @db.LongText // Rich text (HTML) — visible to all
  technician_notes String? @db.Text // Notes from CS to technician — plain text

  is_for_self      Boolean @default(true)  // false = ticket created on behalf of another person
  customer_name    String?                 // Name of the actual recipient (if is_for_self = false)
  customer_phone   String?
  customer_email   String?
  customer_address String? @db.Text

  customer_type    CustomerType @default(User)

  // CS intake fields
  accessories      String? @db.Text // accessories included with device
  device_condition String? @db.Text // customer-described physical condition
  device_name      String?        // Optional device name
  device_sn        String?        // Optional device serial number
  warranty_status  String?        // 'active' or 'inactive'
  is_overnight     Boolean  @default(false)  // true = multi-day service
  is_overnight_check Boolean @default(false)
  checking_fee     Decimal? @db.Decimal(12,2)
  pickup_method    PickupMethod?
  terms_accepted   Boolean  @default(false)

  payment_proof_url   String? @db.Text
  delivery_proof_url  String? @db.Text
  progress_proof_url  String? @db.Text
  revision_proof_url  String? @db.Text

  // Extra services added during the ticket (e.g. "Repaste", "Upgrade") — each adds +3 bonus points
  extra_services      Json      @default("[]")

  // Public access
  public_chat_enabled Boolean @default(false)
  public_share_token  String? @unique    // secure token for /ticket/[token] public page

  // Performance tracking timestamps
  work_started_at   DateTime?  // set when technician moves to on_progress
  work_completed_at DateTime?  // set when technician moves to done

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  attachments      TicketAttachment[]
  messages         TicketMessage[]
  status_logs      TicketStatusLog[]
  time_logs        TicketTimeLog[]
  notifications    Notification[]
  service_detail   TicketServiceDetail?
  warranty_detail  TicketWarrantyDetail?
  cleaning_detail  TicketCleaningDetail?
  upgrade_details  TicketUpgradeDetail[]
  pc_build_detail  TicketPcBuildDetail?
  pc_components    TicketPcBuildComponent[]
  assignment_requests TicketAssignmentRequest[]
  rma_case         RmaCase?

  @@index([user_id])
  @@index([technician_id])
  @@index([store_location_id])
  @@index([public_share_token])
}

model TicketAssignmentRequest {
  id            String   @id @default(cuid())
  ticket_id     String
  ticket        Ticket   @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  technician_id String
  technician    User     @relation(fields: [technician_id], references: [id], onDelete: Cascade)
  status        String   @default("pending") // pending, approved, rejected
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@unique([ticket_id, technician_id])
}

// ─────────────────────────────────────────────
// TICKET DETAIL TABLES
// ─────────────────────────────────────────────

model TicketServiceDetail {
  id        String @id @default(cuid())
  ticket_id String @unique
  ticket    Ticket @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
}

model TicketWarrantyDetail {
  id            String   @id @default(cuid())
  ticket_id     String   @unique
  ticket        Ticket   @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  purchase_date DateTime

  // Set by the server when a technician closes a claim as ineligible. The
  // ticket still goes to `done` so the normal handover chain can return the
  // unit to the customer — see docs/rma-test-checklist.md.
  claim_eligible       Boolean @default(true)
  ineligibility_reason String? @db.Text
}

model TicketCleaningDetail {
  id              String          @id @default(cuid())
  ticket_id       String          @unique
  ticket          Ticket          @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  service_package CleaningPackage
}

model Upgrade {
  id     String @id @default(cuid())
  name   String @unique
  points Int    @default(2)

  upgrade_details TicketUpgradeDetail[]
}

model TicketUpgradeDetail {
  id         String  @id @default(cuid())
  ticket_id  String
  ticket     Ticket  @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  upgrade_id String
  upgrade    Upgrade @relation(fields: [upgrade_id], references: [id])
}

model TicketPcBuildDetail {
  id                 String  @id @default(cuid())
  ticket_id          String  @unique
  ticket             Ticket  @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  first_build_url    String? @db.Text // Uploaded by technician upon marking done
  revision_build_url String? @db.Text // Uploaded by assigned Sales
}

model TicketPcBuildComponent {
  id             String @id @default(cuid())
  ticket_id      String
  ticket         Ticket @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  component_name String
}

// ─────────────────────────────────────────────
// ATTACHMENTS & MESSAGES
// ─────────────────────────────────────────────

model TicketAttachment {
  id         String   @id @default(cuid())
  ticket_id  String
  ticket     Ticket   @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  file_url   String @db.Text
  file_type  FileType
  created_at DateTime @default(now())
}

model TicketMessage {
  id        String @id @default(cuid())
  ticket_id String
  ticket    Ticket @relation(fields: [ticket_id], references: [id], onDelete: Cascade)

  sender_id   String?       // null = anonymous public message
  sender      User?   @relation(fields: [sender_id], references: [id])
  sender_name String?       // for anonymous senders

  message  String @db.Text
  is_read  Boolean @default(false)

  created_at DateTime @default(now())

  @@index([ticket_id])
}

// ─────────────────────────────────────────────
// STATUS LOGS
// ─────────────────────────────────────────────

model TicketStatusLog {
  id         String       @id @default(cuid())
  ticket_id  String
  ticket     Ticket       @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  old_status TicketStatus?
  new_status TicketStatus
  reason     String? @db.Text
  changed_by String
  changer    User         @relation(fields: [changed_by], references: [id])
  created_at DateTime     @default(now())
}

// ─────────────────────────────────────────────
// WORKLOAD & PERFORMANCE
// ─────────────────────────────────────────────

model TechnicianWorkload {
  id             String   @id @default(cuid())
  technician_id  String   @unique
  technician     User     @relation(fields: [technician_id], references: [id])
  current_points Int      @default(0)
  max_points     Int      @default(7)
  updated_at     DateTime @updatedAt
}

model TechnicianPerformance {
  id            String @id @default(cuid())
  technician_id String @unique
  technician    User   @relation(fields: [technician_id], references: [id])

  tickets_handled        Int @default(0)
  success_count          Int @default(0)
  failed_count           Int @default(0)
  total_points_completed Int @default(0)

  updated_at DateTime @updatedAt
}

model Leaderboard {
  id            String @id @default(cuid())
  technician_id String
  technician    User   @relation(fields: [technician_id], references: [id])

  month Int
  year  Int

  total_points    Int
  tickets_handled Int

  created_at DateTime @default(now())
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────

model Notification {
  id        String @id @default(cuid())
  user_id   String
  user      User   @relation(fields: [user_id], references: [id])
  ticket_id String
  ticket    Ticket @relation(fields: [ticket_id], references: [id], onDelete: Cascade)

  type         NotificationType
  reference_id String? // e.g. message_id or status_log_id
  message      String? @db.Text // Optional human-readable detail (e.g. points earned message)

  is_read Boolean @default(false)

  created_at DateTime @default(now())

  @@index([user_id])
}

// ─────────────────────────────────────────────
// TIME LOGGING & SCHEDULING (PHASE 3)
// ─────────────────────────────────────────────

model TicketTimeLog {
  id         String       @id @default(cuid())
  ticket_id  String
  ticket     Ticket       @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  event      TimeLogEvent
  reason     String? @db.Text
  created_at DateTime     @default(now())

  @@index([ticket_id])
}

model TechnicianLeave {
  id            String   @id @default(cuid())
  technician_id String
  technician    User     @relation(fields: [technician_id], references: [id], onDelete: Cascade)
  date          DateTime @db.Date
  reason        String? @db.Text
  is_off_day    Boolean  @default(false)
  created_at    DateTime @default(now())

  @@unique([technician_id, date])
}

model ShiftOverride {
  id               String   @id @default(cuid())
  original_tech_id String
  override_tech_id String
  original_tech    User     @relation("OriginalShift", fields: [original_tech_id], references: [id], onDelete: Cascade)
  override_tech    User     @relation("OverrideShift", fields: [override_tech_id], references: [id], onDelete: Cascade)
  date             DateTime @db.Date
  shift            Shift
  created_at       DateTime @default(now())

  @@unique([original_tech_id, date])
}

// ─────────────────────────────────────────────
// ACHIEVEMENT TITLES (Game Inventory)
// ─────────────────────────────────────────────

model UserTitle {
  id          String   @id @default(cuid())
  user_id     String
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  title_key   String   // e.g. "technician_2026_04" or "coordinator_2026_05"
  title_label String   // e.g. "Technician of April 2026"
  title_type  String   // "technician" | "coordinator"
  emoji       String   @default("🏆")
  awarded_at  DateTime @default(now())

  @@unique([user_id, title_key])
  @@index([user_id])
}

// ─────────────────────────────────────────────
// RMA — WARRANTY CLAIM SENT TO VENDOR
// ─────────────────────────────────────────────

// One case per warranty_claim ticket, created when the technician hands the
// unit over to the RMA desk. The parent ticket sits at `rma_process` for the
// whole vendor round-trip and returns to `done` when the case closes, so the
// existing handover chain (ready_for_pickup / handed_to_courier -> completed)
// keeps working untouched.
model RmaCase {
  id        String    @id @default(cuid())
  rma_code  String    @unique          // RMA-{STORECODE}-{YYMM}-{0001}
  ticket_id String    @unique
  ticket    Ticket    @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  status    RmaStatus @default(pending_verification)

  // ── Service form — filled by the technician at handover ──
  unit_ownership       UnitOwnership
  stock_origin         String?   // free text, required when unit_ownership = store_stock
  purchase_invoice_url String? @db.Text // required when unit_ownership = customer
  sn_verified          Boolean   @default(false)
  physical_condition   String @db.Text
  fault_description    String @db.Text
  test_result          String
  handed_over_by_id    String
  handed_over_by       User      @relation("RmaHandedOverBy", fields: [handed_over_by_id], references: [id])
  handed_over_at       DateTime  @default(now())

  // ── Technician's recommendation at handover ──
  // Advisory only. The RMA desk decides eligibility; this records what the
  // person who physically examined the unit thought. It must never gate a
  // transition, preselect the desk's choice, or reach the public page.
  // Nullable in the database because seven cases predate this field; required
  // at handover in the application, the same way device_sn is.
  recommended_eligible Boolean?
  recommendation_note  String? @db.Text

  // ── Handling ──
  handler_id  String?
  handler     User?   @relation("RmaHandler", fields: [handler_id], references: [id])
  hold_reason String? @db.Text

  // ── Vendor ──
  vendor_name       String?
  vendor_rma_number String?   // internal only — never shown on the public page
  shipping_tracking String?
  submitted_at      DateTime?

  // ── Outcome ──
  decision         RmaDecision?
  decision_notes   String? @db.Text
  replacement_sn   String?     // required when decision = replaced
  decided_at       DateTime?
  unit_received_at DateTime?
  closed_at        DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  events RmaEvent[]

  @@index([status])
  @@index([handler_id])
}

// Append-only audit trail of every RMA state change.
model RmaEvent {
  id          String     @id @default(cuid())
  rma_case_id String
  rma_case    RmaCase    @relation(fields: [rma_case_id], references: [id], onDelete: Cascade)
  from_status RmaStatus?
  to_status   RmaStatus
  note        String? @db.Text
  actor_id    String
  actor       User       @relation(fields: [actor_id], references: [id])
  created_at  DateTime   @default(now())

  @@index([rma_case_id])
}
